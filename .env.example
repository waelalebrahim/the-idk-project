# Copy this file to .env for local dev. On Vercel, set these in
# Project Settings -> Environment Variables (never commit the real .env).

# Your AI provider API key — this is the secret the proxy guards.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# The model your API access supports. Change if yours differs.
MODEL=claude-sonnet-4-6

# Your live site origin, used to reject requests from other sites.
# e.g. https://theidkproject.ai  (leave blank to allow all during testing)
SITE_ORIGIN=
